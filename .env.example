# Set to the real production origin before deployment. No domain was supplied.
NEXT_PUBLIC_SITE_URL=

# Blog comments (see DESIGN.md §15 and HANDOFF.md).
# Neon Postgres connection string; the Vercel ↔ Neon integration sets it for you.
# For local work: DATABASE_URL=pglite:./.pglite (a Postgres inside Node, nothing to install).
DATABASE_URL=

# Moderation panel sign-in: a GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Callback URL: https://<your domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The only GitHub account let in.
ADMIN_GITHUB_LOGIN=FabioMarinhoDesenvolvedor
# 32+ random characters: signs the owner's session and hashes visitor IPs (rate limit).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Local only (npm run dev): sign in to the panel without GitHub. Ignored in production.
# ADMIN_DEV_LOGIN=1
