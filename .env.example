# Set to the real production origin before deployment. No domain was supplied.
NEXT_PUBLIC_SITE_URL=

# Blog comments (see DESIGN.md §15 and HANDOFF.md).
# Neon Postgres connection string; the Vercel ↔ Neon integration sets it for you.
# For local work: DATABASE_URL=pglite:./.pglite (a Postgres inside Node, nothing to install).
DATABASE_URL=

# Moderation panel sign-in: a GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Callback URL: https://<your domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The only GitHub account let in.
ADMIN_GITHUB_LOGIN=FabioMarinhoDesenvolvedor
# 32+ random characters: signs the owner's session and hashes visitor IPs (rate limit).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Post editor (/admin/posts): a fine-grained token for this repository only, with Contents and
# Pull requests read/write and Commit statuses and Deployments read. Without it, drafts can be
# written and saved but not sent for review or published.
GITHUB_CONTENT_TOKEN=
# GITHUB_REPO=FabioMarinhoDesenvolvedor/connections-hub
# GITHUB_API_URL=https://api.github.com   (point at a mock for tests)

# Local only (npm run dev): sign in to the panel without GitHub. Ignored in production.
# ADMIN_DEV_LOGIN=1

# HubMonitor preview on the home page (src/lib/monitor.ts). Read on the server, every 2 minutes.
# Public address of the monitor (the "Open the monitor" link). Default: https://monitor.connectionshub.com.br
# HUBMONITOR_PUBLIC_URL=
# Where the server reads /api/v1/summary from, if different (local: http://127.0.0.1:3100).
# HUBMONITOR_API_URL=
